# Browser-safe frontend configuration only.
# Never place database credentials, backend secrets, or API keys in this file.

# Base path of the MajiGuard FastAPI backend as the browser sees it.
# Default: /api/v1 (served through the Vite dev proxy in development).
VITE_API_BASE_URL=/api/v1

# Dev-server-only proxy target for /api requests.
# Deliberately not prefixed with VITE_ so it is never exposed to the browser bundle.
DEV_API_TARGET=http://127.0.0.1:8000

# CARTO basemap tile API key (free tier: carto.com/basemaps/apikey).
# Required since CARTO started watermarking anonymous basemaps.cartocdn.com
# requests with "API KEY REQUIRED". Leave blank to keep that watermark.
# This is a client-exposed, domain-restrictable key, not a backend secret.
VITE_CARTO_BASEMAP_KEY=
